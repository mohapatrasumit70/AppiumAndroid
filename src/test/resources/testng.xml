<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  testng.xml — Master suite configuration.
  To run:  mvn clean test
  Groups:  mvn clean test -Dgroups=smoke
-->
<suite name="Android Automation Suite" verbose="1" thread-count="1" parallel="none">

    <!-- Global listeners -->
    <listeners>
        <listener class-name="com.company.framework.listeners.TestNGListener"/>
    </listeners>

    <!-- ── Smoke Suite ───────────────────────────────────────────────── -->
    <test name="Login Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.company.tests.LoginTest"/>
            <!-- Add more test classes below as your suite grows -->
        </classes>
    </test>

</suite>
